{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Renovation Knowledge Graph Node V0.1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "status",
    "summary",
    "scope",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "unverified",
        "reviewed",
        "deprecated"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "target"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "conditions": {
            "type": "object"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
